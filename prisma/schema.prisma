generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// ENUMS
// ==========================================
enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum PlatformRole {
  SUPERADMIN
  SUPPORT
}

enum SaasPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  VOID
}

enum UserRole {
  ADMIN
  STAFF
}

enum RenterStatus {
  ACTIVE
  INACTIVE
}

enum PropertyType {
  DEPARTAMENTO
  CASA
  LOCAL
  TERRENO
  OFICINA
  COCHERA
  OTRO
}

enum PropertyStatus {
  DISPONIBLE
  ALQUILADO
  MANTENIMIENTO
  ARCHIVADO
}

enum PropertyOperation {
  RENT
  SALE
  TEMPORARY_RENT
  MANAGEMENT
}

enum PropertyCommercialStatus {
  DRAFT
  AVAILABLE
  RESERVED
  UNDER_NEGOTIATION
  CLOSED
  PAUSED
  ARCHIVED
}

enum ContactRoleType {
  PROSPECT
  BUYER
  RENTAL_PROSPECT
  RENTER
  OWNER
  GUARANTOR
  PROVIDER
  GENERAL
}

enum SpaceStatus {
  FREE
  OCCUPIED
  MAINTENANCE
}

enum LeaseStatus {
  DRAFT
  CURRENT
  EXPIRING
  RENEWED
  TERMINATED
  CANCELED
}

enum LeaseType {
  PROPERTY
  GARAGE
}

enum DebtType {
  ALQUILER
  EXPENSAS
  DEPOSITO
  LUZ
  GAS
  AGUA
  SEGURO
  IMPUESTO
  PENALIDAD
  INTERES
  NOTA_DEBITO
  NOTA_CREDITO
  OTROS
}

enum DebtStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  MERCADOPAGO
  OTRO
}

enum AuditActorType {
  USER
  SUPERADMIN
  RENTER
  OWNER
  SYSTEM
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPERTIES_SENT
  VISIT_SCHEDULED
  VISITED
  NEGOTIATION
  RESERVATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InteractionType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  NOTE
  OTHER
}

enum DemandStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum PropertyInterestStatus {
  MATCHED
  SENT
  FAVORITE
  REJECTED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CalendarEventType {
  VISIT
  MEETING
  CALL
  OTHER
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ENDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELED
  CONVERTED
}

enum DealStatus {
  OPEN
  NEGOTIATION
  WON
  LOST
  CANCELED
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELED
}

enum SettlementStatus {
  DRAFT
  READY
  PAID
  CANCELED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  TRIAGED
  QUOTED
  APPROVED
  IN_PROGRESS
  WAITING_PARTS
  RESOLVED
  CANCELED
}

enum MaintenanceCostBearer {
  OWNER
  RENTER
  TENANT
  INSURANCE
  UNASSIGNED
}

enum InspectionType {
  ENTRY
  EXIT
  PERIODIC
  OTHER
}

enum InspectionStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum InspectionSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ==========================================
// PLANO PLATAFORMA SAAS (SUPERADMIN)
// ==========================================
model Tenant {
  id            String       @id @default(uuid())
  slug          String       @unique @db.VarChar(80)
  name          String       @db.VarChar(160)
  status        TenantStatus @default(ACTIVE)
  timezone      String       @default("America/Argentina/Buenos_Aires") @db.VarChar(80)
  logoUrl       String?      @db.VarChar(500)
  address       String?      @db.VarChar(255)
  phone         String?      @db.VarChar(50)
  cuit          String?      @db.VarChar(30)
  receiptHeader String?      @db.VarChar(255)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  archivedAt    DateTime?

  domains               TenantDomain[]
  subscriptions         TenantSubscription[]
  featureOverrides      TenantFeatureOverride[]
  saasPayments          SaasPayment[]
  users                 User[]
  renters               PropertyRenter[]
  contacts              Contact[]
  properties            Property[]
  garages               Garage[]
  propertyLeases        PropertyLease[]
  garageLeases          GarageLease[]
  debts                 Debt[]
  payments              Payment[]
  documents             Document[]
  settings              TenantSetting[]
  roleProfiles          RoleProfile[]
  auditLogs             AuditLog[]
  counters              TenantCounter[]
  propertyOwners        PropertyOwner[]
  leads                 Lead[]
  leadInteractions      LeadInteraction[]
  demands               Demand[]
  leadPropertyInterests LeadPropertyInterest[]
  tasks                 Task[]
  calendarEvents        CalendarEvent[]
  publications          Publication[]
  reservations          Reservation[]
  deals                 Deal[]
  propertyExpenses      PropertyExpense[]
  ownerSettlements      OwnerSettlement[]
  recurringCharges      RecurringCharge[]
  providerProfiles      ProviderProfile[]
  maintenanceRequests   MaintenanceRequest[]
  maintenanceEvents     MaintenanceEvent[]
  inspections           Inspection[]
  inspectionFindings    InspectionFinding[]
}

model TenantDomain {
  id         String    @id @default(uuid())
  tenantId   String
  hostname   String    @unique @db.VarChar(180)
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Plan {
  id              String   @id @default(uuid())
  code            String   @unique @db.VarChar(60)
  name            String   @db.VarChar(120)
  description     String?  @db.Text
  priceMonthly    Decimal  @default(0.00) @db.Decimal(12, 2)
  priceYearly     Decimal  @default(0.00) @db.Decimal(12, 2)
  maxProperties   Int      @default(50)
  maxGarages      Int      @default(10)
  maxUsers        Int      @default(5)
  maxPublications Int      @default(50)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id                 String             @id @default(uuid())
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId, status])
  @@index([planId])
}

model TenantFeatureOverride {
  id         String   @id @default(uuid())
  tenantId   String
  featureKey String   @db.VarChar(80)
  enabled    Boolean
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
}

model SaasPayment {
  id          String            @id @default(uuid())
  tenantId    String
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("ARS") @db.VarChar(10)
  status      SaasPaymentStatus @default(PENDING)
  paymentDate DateTime          @default(now())
  reference   String?           @db.VarChar(120)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentDate])
}

model SuperAdminUser {
  id           String       @id @default(uuid())
  email        String       @unique @db.VarChar(120)
  passwordHash String       @db.VarChar(255)
  name         String       @db.VarChar(120)
  role         PlatformRole @default(SUPERADMIN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ==========================================
// PLANO INMOBILIARIA (TENANT SCOPED)
// ==========================================
model User {
  id            String   @id @default(uuid())
  tenantId      String
  roleProfileId String?
  email         String   @db.VarChar(120)
  passwordHash  String   @db.VarChar(255)
  name          String   @db.VarChar(120)
  role          UserRole @default(ADMIN)
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleProfile            RoleProfile?         @relation(fields: [roleProfileId], references: [id], onDelete: SetNull)
  assignedProperties     Property[]           @relation("PropertyAgent")
  auditLogs              AuditLog[]
  assignedLeads          Lead[]               @relation("LeadAgent")
  leadInteractions       LeadInteraction[]    @relation("InteractionUser")
  assignedTasks          Task[]               @relation("TaskAssignee")
  calendarEvents         CalendarEvent[]      @relation("EventAgent")
  reservations           Reservation[]        @relation("ReservationAgent")
  deals                  Deal[]               @relation("DealAgent")
  maintenanceAssignments MaintenanceRequest[] @relation("MaintenanceAssignee")
  maintenanceEvents      MaintenanceEvent[]   @relation("MaintenanceEventActor")
  inspections            Inspection[]         @relation("InspectionInspector")

  @@unique([tenantId, email])
  @@index([tenantId, isActive])
  @@index([roleProfileId])
}

model RoleProfile {
  id          String   @id @default(uuid())
  tenantId    String
  key         String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model RolePermission {
  id        String   @id @default(uuid())
  roleId    String
  module    String   @db.VarChar(60)
  action    String   @db.VarChar(40)
  createdAt DateTime @default(now())

  role RoleProfile @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module, action])
  @@index([roleId])
}

model Contact {
  id                      String   @id @default(uuid())
  tenantId                String
  firstName               String   @db.VarChar(80)
  lastName                String   @db.VarChar(80)
  companyName             String?  @db.VarChar(160)
  documentType            String?  @db.VarChar(20)
  documentNumber          String?  @db.VarChar(40)
  cuit                    String?  @db.VarChar(30)
  email                   String?  @db.VarChar(120)
  phone                   String?  @db.VarChar(50)
  alternatePhone          String?  @db.VarChar(50)
  address                 String?  @db.VarChar(255)
  city                    String?  @db.VarChar(100)
  province                String?  @db.VarChar(100)
  postalCode              String?  @db.VarChar(20)
  bankAlias               String?  @db.VarChar(120)
  bankCbu                 String?  @db.VarChar(40)
  ownerPortalPasswordHash String?  @db.VarChar(255)
  ownerPortalEnabled      Boolean  @default(false)
  ownerPortalLastLoginAt  DateTime?
  notes                   String?  @db.Text
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  archivedAt              DateTime?

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles                ContactRole[]
  ownedProperties      PropertyOwner[]
  leads                Lead[]
  demands              Demand[]
  tasks                Task[]
  calendarEvents       CalendarEvent[]
  reservations         Reservation[]
  deals                Deal[]
  providedExpenses     PropertyExpense[]     @relation("ExpenseProvider")
  chargedOwnerExpenses PropertyExpense[]     @relation("ExpenseOwner")
  ownerSettlements     OwnerSettlement[]     @relation("OwnerSettlementContact")
  guaranteedLeases     PropertyLease[]       @relation("LeaseGuarantor")
  providerProfile      ProviderProfile?
  providedMaintenance  MaintenanceRequest[]  @relation("MaintenanceProvider")

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, email])
  @@index([tenantId, documentNumber])
  @@index([tenantId, ownerPortalEnabled])
}

model ContactRole {
  id        String          @id @default(uuid())
  contactId String
  role      ContactRoleType
  createdAt DateTime        @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, role])
  @@index([contactId])
}

model PropertyRenter {
  id                 String       @id @default(uuid())
  tenantId           String
  firstName          String       @db.VarChar(80)
  lastName           String       @db.VarChar(80)
  dni                String       @db.VarChar(30)
  email              String?      @db.VarChar(120)
  phone              String?      @db.VarChar(50)
  address            String?      @db.VarChar(200)
  status             RenterStatus @default(ACTIVE)
  portalPasswordHash String?      @db.VarChar(255)
  notes              String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyLeases      PropertyLease[]
  garageLeases        GarageLease[]
  debts               Debt[]
  documents           Document[]
  maintenanceRequests MaintenanceRequest[]
  inspections         Inspection[]

  @@unique([tenantId, dni])
  @@index([tenantId, email])
  @@index([tenantId, status])
}

model Property {
  id                  String                   @id @default(uuid())
  tenantId            String
  agentId             String?
  code                String                   @db.VarChar(50)
  address             String                   @db.VarChar(255)
  type                PropertyType             @default(DEPARTAMENTO)
  subtype             String?                  @db.VarChar(80)
  operation           PropertyOperation        @default(RENT)
  commercialStatus    PropertyCommercialStatus @default(AVAILABLE)
  rooms               Int?
  bedrooms            Int?
  bathrooms           Int?
  garageCount         Int?
  sqm                 Decimal?                 @db.Decimal(10, 2)
  coveredSqm          Decimal?                 @db.Decimal(10, 2)
  semiCoveredSqm      Decimal?                 @db.Decimal(10, 2)
  landSqm             Decimal?                 @db.Decimal(10, 2)
  baseRent            Decimal?                 @db.Decimal(12, 2)
  rentPrice           Decimal?                 @db.Decimal(14, 2)
  salePrice           Decimal?                 @db.Decimal(14, 2)
  currency            String                   @default("ARS") @db.VarChar(10)
  expenses            Decimal?                 @db.Decimal(12, 2)
  expensesShare       Decimal?                 @db.Decimal(6, 2)
  commissionPercent   Decimal?                 @db.Decimal(6, 2)
  street              String?                  @db.VarChar(160)
  streetNumber        String?                  @db.VarChar(30)
  floor               String?                  @db.VarChar(20)
  unit                String?                  @db.VarChar(20)
  city                String?                  @db.VarChar(100)
  province            String?                  @db.VarChar(100)
  country             String                   @default("Argentina") @db.VarChar(80)
  postalCode          String?                  @db.VarChar(20)
  latitude            Decimal?                 @db.Decimal(10, 7)
  longitude           Decimal?                 @db.Decimal(10, 7)
  ageYears            Int?
  orientation         String?                  @db.VarChar(50)
  amenities           Json?
  publicDescription   String?                  @db.Text
  internalDescription String?                  @db.Text
  coverImageUrl       String?                  @db.VarChar(500)
  availableFrom       DateTime?                @db.Date
  capturedAt          DateTime?
  captureSource       String?                  @db.VarChar(100)
  publishedAt         DateTime?
  status              PropertyStatus           @default(DISPONIBLE)
  notes               String?                  @db.Text
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  archivedAt          DateTime?

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent                 User?                  @relation("PropertyAgent", fields: [agentId], references: [id], onDelete: SetNull)
  owners                PropertyOwner[]
  propertyLeases        PropertyLease[]
  documents             Document[]
  leadPropertyInterests LeadPropertyInterest[]
  tasks                 Task[]
  calendarEvents        CalendarEvent[]
  publications          Publication[]
  reservations          Reservation[]
  deals                 Deal[]
  propertyExpenses      PropertyExpense[]
  settlementLines       OwnerSettlementLine[]
  maintenanceRequests   MaintenanceRequest[]
  inspections           Inspection[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, commercialStatus])
  @@index([tenantId, operation, type])
  @@index([tenantId, city])
  @@index([agentId])
}

model PropertyOwner {
  id                   String   @id @default(uuid())
  tenantId             String
  propertyId           String
  contactId            String
  ownershipPercentage  Decimal  @default(100.00) @db.Decimal(6, 2)
  isPrimary            Boolean  @default(false)
  settlementPreference String?  @db.VarChar(120)
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([propertyId, contactId])
  @@index([tenantId, propertyId])
  @@index([tenantId, contactId])
}

model Garage {
  id          String   @id @default(uuid())
  tenantId    String
  name        String   @db.VarChar(120)
  address     String   @db.VarChar(255)
  totalSpaces Int      @default(0)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spaces GarageSpace[]

  @@index([tenantId])
}

model GarageSpace {
  id          String      @id @default(uuid())
  garageId    String
  spaceNumber String      @db.VarChar(30)
  status      SpaceStatus @default(FREE)
  notes       String?     @db.VarChar(200)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  garage      Garage             @relation(fields: [garageId], references: [id], onDelete: Cascade)
  leaseSpaces GarageLeaseSpace[]

  @@unique([garageId, spaceNumber])
  @@index([garageId, status])
}

model PropertyLease {
  id                 String      @id @default(uuid())
  tenantId           String
  propertyId         String
  renterId           String
  guarantorContactId String?
  startDate          DateTime    @db.Date
  endDate            DateTime    @db.Date
  extensionUntil     DateTime?   @db.Date
  currentRent        Decimal     @db.Decimal(12, 2)
  deposit            Decimal     @default(0.00) @db.Decimal(12, 2)
  increasePercent    Decimal     @default(0.00) @db.Decimal(6, 2)
  updatePeriodMonths Int         @default(4)
  adjustmentMethod   String      @default("FIXED_PERCENT") @db.VarChar(40)
  adjustmentIndex    String?     @db.VarChar(40)
  nextAdjustmentDate DateTime?   @db.Date
  guaranteeType      String?     @db.VarChar(80)
  guaranteeDetails   String?     @db.Text
  renewalReference   String?     @db.VarChar(120)
  entryChecklist     Json?
  exitChecklist      Json?
  inventoryNotes     String?     @db.Text
  status             LeaseStatus @default(CURRENT)
  notes              String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property            Property             @relation(fields: [propertyId], references: [id])
  renter              PropertyRenter       @relation(fields: [renterId], references: [id])
  guarantor           Contact?             @relation("LeaseGuarantor", fields: [guarantorContactId], references: [id], onDelete: SetNull)
  rentHistory         RentHistory[]
  debts               Debt[]
  documents           Document[]
  recurringCharges    RecurringCharge[]
  deal                Deal?
  maintenanceRequests MaintenanceRequest[]
  inspections         Inspection[]

  @@index([tenantId, status])
  @@index([tenantId, endDate])
  @@index([tenantId, nextAdjustmentDate])
  @@index([propertyId])
  @@index([renterId])
  @@index([guarantorContactId])
}

model GarageLease {
  id              String      @id @default(uuid())
  tenantId        String
  renterId        String
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  rentPerSpace    Decimal     @default(0.00) @db.Decimal(12, 2)
  totalRent       Decimal     @db.Decimal(12, 2)
  deposit         Decimal     @default(0.00) @db.Decimal(12, 2)
  increasePercent Decimal     @default(0.00) @db.Decimal(6, 2)
  status          LeaseStatus @default(CURRENT)
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  renter      PropertyRenter     @relation(fields: [renterId], references: [id])
  spaces      GarageLeaseSpace[]
  rentHistory RentHistory[]
  debts       Debt[]

  @@index([tenantId, status])
  @@index([tenantId, endDate])
  @@index([renterId])
}

model GarageLeaseSpace {
  id        String   @id @default(uuid())
  leaseId   String
  spaceId   String
  createdAt DateTime @default(now())

  lease GarageLease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  space GarageSpace @relation(fields: [spaceId], references: [id])

  @@unique([leaseId, spaceId])
  @@index([spaceId])
}

model RentHistory {
  id              String    @id @default(uuid())
  propertyLeaseId String?
  garageLeaseId   String?
  changeDate      DateTime   @db.Date
  oldRent         Decimal    @db.Decimal(12, 2)
  newRent         Decimal    @db.Decimal(12, 2)
  percent         Decimal?   @db.Decimal(6, 2)
  indexUsed       String?    @db.VarChar(50)
  notes           String?    @db.VarChar(255)
  createdAt       DateTime   @default(now())

  propertyLease PropertyLease? @relation(fields: [propertyLeaseId], references: [id], onDelete: Cascade)
  garageLease   GarageLease?   @relation(fields: [garageLeaseId], references: [id], onDelete: Cascade)

  @@index([propertyLeaseId, changeDate])
  @@index([garageLeaseId, changeDate])
}

model Debt {
  id              String     @id @default(uuid())
  tenantId        String
  leaseType       LeaseType  @default(PROPERTY)
  propertyLeaseId String?
  garageLeaseId   String?
  renterId        String
  type            DebtType   @default(ALQUILER)
  description     String     @db.VarChar(255)
  amount          Decimal    @db.Decimal(12, 2)
  dueDate         DateTime   @db.Date
  paidAmount      Decimal    @default(0.00) @db.Decimal(12, 2)
  status          DebtStatus @default(PENDING)
  generatedAt     DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyLease PropertyLease? @relation(fields: [propertyLeaseId], references: [id], onDelete: Cascade)
  garageLease   GarageLease?   @relation(fields: [garageLeaseId], references: [id], onDelete: Cascade)
  renter        PropertyRenter @relation(fields: [renterId], references: [id])
  payments      Payment[]

  @@index([tenantId, dueDate])
  @@index([tenantId, status])
  @@index([tenantId, renterId])
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  debtId        String
  amount        Decimal       @db.Decimal(12, 2)
  paidAt        DateTime      @default(now())
  method        PaymentMethod @default(EFECTIVO)
  reference     String?       @db.VarChar(120)
  receiptNumber String?       @db.VarChar(60)
  receiptPdfUrl String?       @db.VarChar(500)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, paidAt])
  @@index([debtId])
}

model Document {
  id                      String   @id @default(uuid())
  tenantId                String
  propertyId              String?
  renterId                String?
  propertyLeaseId         String?
  maintenanceRequestId    String?
  inspectionId            String?
  contactId               String?
  dealId                  String?
  paymentId               String?
  ownerSettlementId       String?
  generatedFromTemplateId String?
  source                  String   @default("UPLOAD") @db.VarChar(40)
  contentSnapshot         String?  @db.LongText
  notes                   String?  @db.Text
  category                String   @db.VarChar(60)
  fileName                String   @db.VarChar(255)
  fileUrl                 String   @db.VarChar(500)
  fileSize                Int?
  mimeType                String?  @db.VarChar(100)
  uploadedAt              DateTime @default(now())
  workflowStatus          String   @default("ARCHIVED") @db.VarChar(20)
  version                 Int      @default(1)
  sentAt                  DateTime?
  viewedAt                DateTime?
  signedAt                DateTime?
  archivedAt              DateTime?
  signatureProvider       String?  @db.VarChar(80)
  signatureExternalId     String?  @db.VarChar(191)
  workflowMetadata        String?  @db.LongText

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property           Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  renter             PropertyRenter?     @relation(fields: [renterId], references: [id], onDelete: SetNull)
  propertyLease      PropertyLease?      @relation(fields: [propertyLeaseId], references: [id], onDelete: SetNull)
  maintenanceRequest MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  inspection         Inspection?         @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([tenantId, category])
  @@index([propertyId])
  @@index([renterId])
  @@index([propertyLeaseId])
  @@index([maintenanceRequestId])
  @@index([inspectionId])
  @@index([contactId], map: "Document_contactId_idx")
  @@index([dealId], map: "Document_dealId_idx")
  @@index([paymentId], map: "Document_paymentId_idx")
  @@index([ownerSettlementId], map: "Document_ownerSettlementId_idx")
  @@index([generatedFromTemplateId], map: "Document_generatedFromTemplateId_idx")
  @@index([tenantId, workflowStatus, uploadedAt], map: "Document_tenant_workflow_idx")
}

model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String
  key       String   @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model TenantCounter {
  id        String   @id @default(uuid())
  tenantId  String
  key       String   @db.VarChar(60)
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model AuditLog {
  id          String         @id @default(uuid())
  tenantId    String
  actorUserId String?
  actorType   AuditActorType @default(SYSTEM)
  action      String         @db.VarChar(80)
  entityType  String         @db.VarChar(80)
  entityId    String?        @db.VarChar(80)
  metadata    Json?
  ipAddress   String?        @db.VarChar(64)
  userAgent   String?        @db.VarChar(500)
  createdAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
}

// ==========================================
// FASE 2 — CRM + OPERACIONES + ADMINISTRACIÓN
// ==========================================
model Lead {
  id                String       @id @default(uuid())
  tenantId          String
  contactId         String
  agentId           String?
  title             String       @db.VarChar(180)
  source            String?      @db.VarChar(100)
  channel           String?      @db.VarChar(60)
  priority          LeadPriority @default(NORMAL)
  score             Int?
  status            LeadStatus   @default(NEW)
  notes             String?      @db.Text
  nextStep          String?      @db.VarChar(255)
  nextActionAt      DateTime?
  firstResponseAt   DateTime?
  lastInteractionAt DateTime?
  closedAt          DateTime?
  lostReason        String?      @db.VarChar(255)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact           Contact                @relation(fields: [contactId], references: [id], onDelete: Restrict)
  agent             User?                  @relation("LeadAgent", fields: [agentId], references: [id], onDelete: SetNull)
  interactions      LeadInteraction[]
  demands           Demand[]
  propertyInterests LeadPropertyInterest[]
  tasks             Task[]
  events            CalendarEvent[]
  reservations      Reservation[]
  deals             Deal[]

  @@index([tenantId, status])
  @@index([tenantId, agentId, status])
  @@index([tenantId, nextActionAt])
  @@index([contactId])
}

model LeadInteraction {
  id         String          @id @default(uuid())
  tenantId   String
  leadId     String
  userId     String?
  type       InteractionType @default(NOTE)
  summary    String          @db.Text
  nextStep   String?         @db.VarChar(255)
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user   User?  @relation("InteractionUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([leadId, occurredAt])
}

model Demand {
  id                 String            @id @default(uuid())
  tenantId           String
  leadId             String?
  contactId          String
  operation          PropertyOperation
  propertyType       PropertyType?
  zones              Json?
  budgetMin          Decimal?          @db.Decimal(14, 2)
  budgetMax          Decimal?          @db.Decimal(14, 2)
  currency           String            @default("ARS") @db.VarChar(10)
  roomsMin           Int?
  bedroomsMin        Int?
  sqmMin             Decimal?          @db.Decimal(10, 2)
  amenities          Json?
  excludedConditions String?           @db.Text
  status             DemandStatus      @default(ACTIVE)
  notes              String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([tenantId, operation, propertyType])
  @@index([contactId])
  @@index([leadId])
}

model LeadPropertyInterest {
  id           String                 @id @default(uuid())
  tenantId     String
  leadId       String
  propertyId   String
  score        Int                    @default(0)
  matchReasons Json?
  status       PropertyInterestStatus @default(MATCHED)
  sentAt       DateTime?
  respondedAt  DateTime?
  notes        String?                @db.Text
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([leadId, propertyId])
  @@index([tenantId, status])
  @@index([propertyId])
}

model Task {
  id             String       @id @default(uuid())
  tenantId       String
  leadId         String?
  contactId      String?
  propertyId     String?
  assignedUserId String?
  title          String       @db.VarChar(180)
  description    String?      @db.Text
  dueAt          DateTime?
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(NORMAL)
  recurrenceRule String?      @db.VarChar(255)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignee User?     @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([assignedUserId, status])
  @@index([leadId])
}

model CalendarEvent {
  id         String              @id @default(uuid())
  tenantId   String
  leadId     String?
  contactId  String?
  propertyId String?
  agentId    String?
  type       CalendarEventType   @default(VISIT)
  status     CalendarEventStatus @default(SCHEDULED)
  title      String              @db.VarChar(180)
  startsAt   DateTime
  endsAt     DateTime?
  location   String?             @db.VarChar(255)
  notes      String?             @db.Text
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  agent    User?     @relation("EventAgent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
  @@index([tenantId, status, startsAt])
  @@index([agentId, startsAt])
}

model Publication {
  id                String            @id @default(uuid())
  tenantId          String
  propertyId        String
  channel           String            @db.VarChar(80)
  status            PublicationStatus @default(DRAFT)
  url               String?           @db.VarChar(500)
  completenessScore Int               @default(0)
  viewsCount        Int               @default(0)
  inquiriesCount    Int               @default(0)
  publishedAt       DateTime?
  unpublishedAt     DateTime?
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, propertyId, channel])
  @@index([tenantId, status])
  @@index([propertyId])
}

model Reservation {
  id               String            @id @default(uuid())
  tenantId         String
  propertyId       String
  contactId        String
  leadId           String?
  agentId          String?
  amount           Decimal           @default(0.00) @db.Decimal(14, 2)
  currency         String            @default("ARS") @db.VarChar(10)
  status           ReservationStatus @default(PENDING)
  expiresAt        DateTime?
  conditions       String?           @db.Text
  commissionAmount Decimal?          @db.Decimal(14, 2)
  notes            String?           @db.Text
  convertedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agent    User?    @relation("ReservationAgent", fields: [agentId], references: [id], onDelete: SetNull)
  deal     Deal?

  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
  @@index([propertyId])
}

model Deal {
  id               String            @id @default(uuid())
  tenantId         String
  propertyId       String
  contactId        String?
  leadId           String?
  reservationId    String?           @unique
  agentId          String?
  propertyLeaseId  String?           @unique
  operation        PropertyOperation
  status           DealStatus        @default(OPEN)
  amount           Decimal?          @db.Decimal(14, 2)
  currency         String            @default("ARS") @db.VarChar(10)
  commissionAmount Decimal?          @db.Decimal(14, 2)
  closedAt         DateTime?
  notes            String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  reservation   Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  agent         User?          @relation("DealAgent", fields: [agentId], references: [id], onDelete: SetNull)
  propertyLease PropertyLease? @relation(fields: [propertyLeaseId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, operation])
  @@index([propertyId])
}

model PropertyExpense {
  id                String        @id @default(uuid())
  tenantId          String
  propertyId        String
  providerContactId String?
  ownerContactId    String?
  category          String        @db.VarChar(80)
  description       String        @db.VarChar(255)
  amount            Decimal       @db.Decimal(14, 2)
  dueDate           DateTime?     @db.Date
  paidAt            DateTime?
  status            ExpenseStatus @default(PENDING)
  chargeToRenter    Boolean       @default(false)
  chargeToOwner     Boolean       @default(true)
  documentUrl       String?       @db.VarChar(500)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  provider Contact? @relation("ExpenseProvider", fields: [providerContactId], references: [id], onDelete: SetNull)
  owner    Contact? @relation("ExpenseOwner", fields: [ownerContactId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueDate])
  @@index([propertyId])
  @@index([providerContactId])
  @@index([ownerContactId])
}

model OwnerSettlement {
  id              String           @id @default(uuid())
  tenantId        String
  ownerContactId  String
  periodStart     DateTime         @db.Date
  periodEnd       DateTime         @db.Date
  grossCollected  Decimal          @default(0.00) @db.Decimal(14, 2)
  expensesTotal   Decimal          @default(0.00) @db.Decimal(14, 2)
  commissionTotal Decimal          @default(0.00) @db.Decimal(14, 2)
  taxesTotal      Decimal          @default(0.00) @db.Decimal(14, 2)
  netAmount       Decimal          @default(0.00) @db.Decimal(14, 2)
  status          SettlementStatus @default(DRAFT)
  paidAt          DateTime?
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  Contact               @relation("OwnerSettlementContact", fields: [ownerContactId], references: [id], onDelete: Restrict)
  lines  OwnerSettlementLine[]

  @@index([tenantId, status])
  @@index([tenantId, periodStart, periodEnd])
  @@index([ownerContactId])
}

model OwnerSettlementLine {
  id           String   @id @default(uuid())
  settlementId String
  propertyId   String?
  type         String   @db.VarChar(60)
  sourceType   String?  @db.VarChar(60)
  sourceId     String?  @db.VarChar(80)
  description  String   @db.VarChar(255)
  amount       Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  settlement OwnerSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  property   Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([settlementId])
  @@index([propertyId])
}

model RecurringCharge {
  id              String    @id @default(uuid())
  tenantId        String
  propertyLeaseId String
  type            DebtType
  description     String    @db.VarChar(255)
  amount          Decimal?  @db.Decimal(12, 2)
  percentage      Decimal?  @db.Decimal(6, 2)
  frequencyMonths Int       @default(1)
  dueDay          Int       @default(10)
  startsAt        DateTime  @db.Date
  endsAt          DateTime? @db.Date
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lease  PropertyLease @relation(fields: [propertyLeaseId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@index([propertyLeaseId, active])
}

// ==========================================
// FASE 3 — MANTENIMIENTO + INSPECCIONES
// ==========================================
model ProviderProfile {
  id            String   @id @default(uuid())
  tenantId      String
  contactId     String   @unique
  specialties   Json?
  rating        Decimal? @db.Decimal(3, 2)
  insuranceInfo String?  @db.VarChar(255)
  isActive      Boolean  @default(true)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

model MaintenanceRequest {
  id                String                @id @default(uuid())
  tenantId          String
  propertyId        String
  propertyLeaseId   String?
  renterId          String?
  providerContactId String?
  assignedUserId    String?
  category          String                @db.VarChar(80)
  priority          MaintenancePriority   @default(NORMAL)
  status            MaintenanceStatus     @default(OPEN)
  title             String                @db.VarChar(180)
  description       String                @db.Text
  reportedBy        String?               @db.VarChar(120)
  quotedAmount      Decimal?              @db.Decimal(14, 2)
  approvedAmount    Decimal?              @db.Decimal(14, 2)
  actualCost        Decimal?              @db.Decimal(14, 2)
  costBearer        MaintenanceCostBearer @default(UNASSIGNED)
  ownerApprovedAt   DateTime?
  scheduledAt       DateTime?
  promisedAt        DateTime?
  startedAt         DateTime?
  resolvedAt        DateTime?
  resolutionNotes   String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  propertyLease PropertyLease?  @relation(fields: [propertyLeaseId], references: [id], onDelete: SetNull)
  renter        PropertyRenter? @relation(fields: [renterId], references: [id], onDelete: SetNull)
  provider      Contact?        @relation("MaintenanceProvider", fields: [providerContactId], references: [id], onDelete: SetNull)
  assignedUser  User?           @relation("MaintenanceAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  events        MaintenanceEvent[]
  documents     Document[]
  findings      InspectionFinding[]

  @@index([tenantId, status, priority])
  @@index([tenantId, providerContactId, status])
  @@index([propertyId, status])
  @@index([propertyLeaseId])
  @@index([renterId])
  @@index([assignedUserId, status])
}

model MaintenanceEvent {
  id                   String             @id @default(uuid())
  tenantId             String
  maintenanceRequestId String
  actorUserId          String?
  fromStatus           MaintenanceStatus?
  toStatus             MaintenanceStatus?
  note                 String?            @db.Text
  createdAt            DateTime           @default(now())

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenanceRequest MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  actor              User?              @relation("MaintenanceEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([maintenanceRequestId, createdAt])
}

model Inspection {
  id              String           @id @default(uuid())
  tenantId        String
  propertyId      String
  propertyLeaseId String?
  renterId        String?
  inspectorUserId String?
  type            InspectionType
  status          InspectionStatus @default(DRAFT)
  scheduledAt     DateTime?
  performedAt     DateTime?
  checklist       Json?
  summary         String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  propertyLease PropertyLease?  @relation(fields: [propertyLeaseId], references: [id], onDelete: SetNull)
  renter        PropertyRenter? @relation(fields: [renterId], references: [id], onDelete: SetNull)
  inspector     User?           @relation("InspectionInspector", fields: [inspectorUserId], references: [id], onDelete: SetNull)
  findings      InspectionFinding[]
  documents     Document[]

  @@index([tenantId, status, scheduledAt])
  @@index([propertyId, performedAt])
  @@index([propertyLeaseId])
  @@index([renterId])
  @@index([inspectorUserId, status])
}

model InspectionFinding {
  id                   String             @id @default(uuid())
  tenantId             String
  inspectionId         String
  maintenanceRequestId String?
  severity             InspectionSeverity @default(INFO)
  area                 String?            @db.VarChar(100)
  description          String             @db.Text
  photos               Json?
  resolved             Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inspection         Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  maintenanceRequest MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)

  @@index([tenantId, severity, resolved])
  @@index([inspectionId])
  @@index([maintenanceRequestId])
}

// ==========================================
// FASE 3.5+ — NOTIFICACIONES, DOCUMENTOS, API Y SAAS
// ==========================================
model NotificationLog {
  id                 String   @id
  tenantId           String
  eventKey           String   @db.VarChar(100)
  channel            String   @default("INTERNAL") @db.VarChar(20)
  audienceType       String   @default("TENANT") @db.VarChar(20)
  recipientRefId     String?  @db.VarChar(191)
  recipientAddress   String?  @db.VarChar(190)
  title              String   @db.VarChar(180)
  body               String   @db.Text
  metadata           String?  @db.LongText
  status             String   @default("SENT") @db.VarChar(20)
  dedupeKey          String   @db.VarChar(191)
  scheduledFor       DateTime?
  sentAt             DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  failureMessage     String?  @db.VarChar(500)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, channel, dedupeKey], map: "NotificationLog_tenant_channel_dedupe_key")
  @@index([tenantId, status, createdAt], map: "NotificationLog_tenant_status_created_idx")
  @@index([tenantId, recipientRefId, status, createdAt], map: "NotificationLog_recipient_status_created_idx")
  @@index([tenantId, eventKey, createdAt], map: "NotificationLog_event_created_idx")
}

model DocumentTemplate {
  id          String   @id
  tenantId    String
  name        String   @db.VarChar(160)
  category    String   @db.VarChar(60)
  description String?  @db.Text
  body        String   @db.LongText
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name], map: "DocumentTemplate_tenant_name_key")
  @@index([tenantId, category, isActive], map: "DocumentTemplate_tenant_category_idx")
}

model ApiCredential {
  id          String   @id
  tenantId    String
  name        String   @db.VarChar(120)
  tokenPrefix String   @db.VarChar(24)
  tokenHash   String   @unique @db.VarChar(64)
  scopes      String   @db.LongText
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId, isActive], map: "ApiCredential_tenant_active_idx")
}

model WebhookEndpoint {
  id        String   @id
  tenantId  String
  name      String   @db.VarChar(120)
  url       String   @db.VarChar(500)
  events    String   @db.LongText
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive], map: "WebhookEndpoint_tenant_active_idx")
}

model WebhookDelivery {
  id            String   @id
  tenantId      String
  endpointId    String
  eventKey      String   @db.VarChar(100)
  payload       String   @db.LongText
  status        String   @default("PENDING") @db.VarChar(20)
  httpStatus    Int?
  attempts      Int      @default(0)
  lastError     String?  @db.VarChar(500)
  deliveredAt   DateTime?
  nextAttemptAt DateTime?
  createdAt     DateTime @default(now())

  @@index([tenantId, eventKey, createdAt], map: "WebhookDelivery_tenant_event_idx")
  @@index([endpointId, status, createdAt], map: "WebhookDelivery_endpoint_status_idx")
  @@index([status, nextAttemptAt, createdAt], map: "WebhookDelivery_retry_idx")
}

model SubscriptionEvent {
  id                String   @id
  tenantId          String
  subscriptionId    String?
  actorSuperAdminId String?
  eventType         String   @db.VarChar(80)
  fromStatus        String?  @db.VarChar(30)
  toStatus          String?  @db.VarChar(30)
  fromPlanCode      String?  @db.VarChar(60)
  toPlanCode        String?  @db.VarChar(60)
  metadata          String?  @db.LongText
  createdAt         DateTime @default(now())

  @@index([tenantId, createdAt], map: "SubscriptionEvent_tenant_created_idx")
}

model ImpersonationGrant {
  id           String   @id
  tenantId     String
  userId       String
  superAdminId String
  tokenHash    String   @unique @db.VarChar(64)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([tenantId, expiresAt], map: "ImpersonationGrant_tenant_exp_idx")
}

// ==========================================
// FASE 4 — INTEGRACIÓN 360
// ==========================================
model ActivityEvent {
  id              String   @id
  tenantId        String
  eventKey        String   @db.VarChar(100)
  title           String   @db.VarChar(180)
  description     String?  @db.Text
  entityType      String   @db.VarChar(80)
  entityId        String?  @db.VarChar(191)
  propertyId      String?  @db.VarChar(191)
  contactId       String?  @db.VarChar(191)
  renterId        String?  @db.VarChar(191)
  actorUserId     String?  @db.VarChar(191)
  metadata        String?  @db.LongText
  webhookQueuedAt DateTime?
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt], map: "ActivityEvent_tenant_created_idx")
  @@index([tenantId, propertyId, createdAt], map: "ActivityEvent_property_created_idx")
  @@index([tenantId, contactId, createdAt], map: "ActivityEvent_contact_created_idx")
  @@index([tenantId, renterId, createdAt], map: "ActivityEvent_renter_created_idx")
  @@index([tenantId, entityType, entityId, createdAt], map: "ActivityEvent_entity_idx")
}

model CommunicationThread {
  id            String   @id
  tenantId      String
  propertyId    String?  @db.VarChar(191)
  contactId     String?  @db.VarChar(191)
  renterId      String?  @db.VarChar(191)
  subject       String   @db.VarChar(180)
  status        String   @default("OPEN") @db.VarChar(20)
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, updatedAt], map: "CommunicationThread_tenant_updated_idx")
  @@index([tenantId, propertyId, updatedAt], map: "CommunicationThread_property_idx")
  @@index([tenantId, contactId, updatedAt], map: "CommunicationThread_contact_idx")
  @@index([tenantId, renterId, updatedAt], map: "CommunicationThread_renter_idx")
}

model CommunicationMessage {
  id               String   @id
  tenantId         String
  threadId         String
  channel          String   @default("INTERNAL") @db.VarChar(20)
  direction        String   @default("OUTBOUND") @db.VarChar(20)
  senderUserId     String?  @db.VarChar(191)
  audienceType     String   @default("TENANT") @db.VarChar(20)
  recipientRefId   String?  @db.VarChar(191)
  recipientAddress String?  @db.VarChar(255)
  body             String   @db.Text
  status           String   @default("QUEUED") @db.VarChar(20)
  externalId       String?  @db.VarChar(191)
  failureMessage   String?  @db.VarChar(500)
  metadata         String?  @db.LongText
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt], map: "CommunicationMessage_tenant_created_idx")
  @@index([threadId, createdAt], map: "CommunicationMessage_thread_created_idx")
  @@index([status, channel, createdAt], map: "CommunicationMessage_queue_idx")
  @@index([tenantId, audienceType, recipientRefId, createdAt], map: "CommunicationMessage_recipient_idx")
}

model FinancialAccount {
  id        String   @id
  tenantId  String
  name      String   @db.VarChar(120)
  type      String   @default("BANK") @db.VarChar(30)
  currency  String   @default("ARS") @db.VarChar(10)
  bankName  String?  @db.VarChar(120)
  alias     String?  @db.VarChar(120)
  cbu       String?  @db.VarChar(40)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isActive], map: "FinancialAccount_tenant_active_idx")
}

model FinancialMovement {
  id                   String   @id
  tenantId             String
  accountId            String
  type                 String   @db.VarChar(30)
  amount               Decimal  @db.Decimal(14, 2)
  currency             String   @default("ARS") @db.VarChar(10)
  concept              String   @db.VarChar(180)
  propertyId           String?  @db.VarChar(191)
  contactId            String?  @db.VarChar(191)
  renterId             String?  @db.VarChar(191)
  debtId               String?  @db.VarChar(191)
  paymentId            String?  @db.VarChar(191)
  propertyExpenseId    String?  @db.VarChar(191)
  ownerSettlementId    String?  @db.VarChar(191)
  reference            String?  @db.VarChar(160)
  reconciliationStatus String   @default("PENDING") @db.VarChar(20)
  notes                String?  @db.Text
  occurredAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  @@unique([tenantId, paymentId], map: "FinancialMovement_payment_key")
  @@index([tenantId, occurredAt], map: "FinancialMovement_tenant_date_idx")
  @@index([accountId, occurredAt], map: "FinancialMovement_account_date_idx")
  @@index([tenantId, propertyId, occurredAt], map: "FinancialMovement_property_idx")
  @@index([tenantId, reconciliationStatus, occurredAt], map: "FinancialMovement_reconciliation_idx")
}
