// Plano de control SaaS dividido en archivo propio.
// Prisma 7 carga todos los *.prisma bajo /prisma mediante prisma.config.ts.
model PlanFeature {
  id         String   @id @default(uuid())
  planId     String
  featureKey String   @db.VarChar(80)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([planId, featureKey])
  @@index([planId])
  @@index([featureKey])
}
