# ==========================================
# OnlyMob SaaS - Environment example
# Copy to .env and replace every CHANGE_ME value.
# Never commit the real .env.
# ==========================================

# Database (MariaDB / MySQL)
MYSQL_DATABASE="onlymob"
MYSQL_USER="onlymob"
MYSQL_PASSWORD="CHANGE_ME_DB_PASSWORD"
MYSQL_ROOT_PASSWORD="CHANGE_ME_ROOT_PASSWORD"
DB_HOST="db"
DATABASE_URL="mysql://onlymob:CHANGE_ME_DB_PASSWORD@db:3306/onlymob"

# Platform & Multi-Tenant
PLATFORM_HOST="onlymob.nanoapps.ar"
TENANT_BASE_DOMAIN="nanoapps.ar"
NEXT_PUBLIC_APP_URL="https://onlymob.nanoapps.ar"

# Security
AUTH_SECRET="CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="CHANGE_ME_RANDOM_SERVER_ACTIONS_KEY"

# Internal automation scheduler
AUTOMATION_CRON_SECRET="CHANGE_ME_RANDOM_AUTOMATION_CRON_SECRET"

# API / Webhook integrations
INTEGRATION_WEBHOOK_SECRET="CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS"

# Communication providers (optional)
# Internal portal messages work without external credentials.
RESEND_API_KEY=""
RESEND_FROM=""
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_GRAPH_VERSION="v24.0"

# Legacy NotificationLog adapters (optional / compatibility)
NOTIFICATION_EMAIL_PROVIDER=""
NOTIFICATION_WHATSAPP_PROVIDER=""
NOTIFICATION_PUSH_PROVIDER=""

# Future electronic signature provider adapter
SIGNATURE_PROVIDER_ENDPOINT=""
SIGNATURE_PROVIDER_TOKEN=""

# Initial SuperAdmin
SUPERADMIN_EMAIL="superadmin@your-domain.example"
SUPERADMIN_PASSWORD="CHANGE_ME_MINIMUM_12_CHARACTERS"
SUPERADMIN_NAME="OnlyMob SuperAdmin"

# Legacy import remains OFF during normal deploys
RUN_LEGACY_MIGRATION="false"

# BCRA
BCRA_API_URL="https://api.bcra.gob.ar/estadisticas/v3.0/Monetarias/7988?limit=1"
BCRA_CSV_URL="https://www.bcra.gob.ar/Downloads/CSV/7988_Indice_para_Contratos_de_Locacion.csv"

# Runtime
TZ="America/Argentina/Buenos_Aires"
